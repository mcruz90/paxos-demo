  "info": {
    "description": "Streaming prior-authorization appeal generation backend.",
    "title": "PaxOS Appeal Generation API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/appeal/generate": {
      "post": {
        "description": "Stream an appeal letter as Server-Sent Events.\n\nAuthentication: enforced by the auth_middleware before this is reached.\n\nReturns a ``text/event-stream`` response emitting ``step``, ``chunk``,\n``done``, and ``error`` events.",
        "operationId": "generate_appeal_api_appeal_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppealRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Generate Appeal"
      }
    },
    "/api/appeal/resume": {
      "post": {
        "description": "Resume a parked exception-tier appeal run for a human reviewer (S3\nSlice 4b).\n\nAuthentication: enforced by the auth_middleware before this is reached,\nwhich also resolves the caller identity onto ``request.state`` \u2014 passed down\nas ``reviewed_by`` for the resume audit entry (ADR-0013). The handler stays\nlogic-free: it reads a plain value, it does not parse auth.\nNo LLM_BACKEND required \u2014 the resume path invokes no model.\n\nReturns a ``text/event-stream`` emitting a terminal ``done`` (the human\nreviewed/edited letter) or ``error`` (nothing awaiting review for the\ngiven ``correlation_id``).",
        "operationId": "resume_appeal_api_appeal_resume_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeAppealRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resume Appeal"
      }
    },
    "/api/audit/records": {
      "get": {
        "description": "List the audit trail (S3 Task 3) \u2014 read-only, metadata + hashes only.\n\nAuthentication: enforced by the auth_middleware before this is reached.\nReturns every :class:`AuditRecord` as-is (identifiers and hashes by design,\nnever letter/request text).",
        "operationId": "list_audit_records_api_audit_records_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecordsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Audit Records"
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Validate demo credentials, mint a session, set the httpOnly cookie.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Destroy the session and clear the cookie.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Return the current session's user (401 if there is no session).",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/pa/submit": {
      "post": {
        "description": "Run the initial-PA lifecycle as Server-Sent Events.\n\nAuthentication: enforced by the auth_middleware before this is reached.\n\nReturns a ``text/event-stream`` response emitting ``step`` and a terminal\n``done`` (InitialPaDoneEvent) or ``error`` event \u2014 never ``chunk``\n(no LLM in this path).",
        "operationId": "submit_initial_pa_api_pa_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitialPaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Initial Pa"
      }
    },
    "/api/reviews/pending": {
      "get": {
        "description": "List exception-tier runs awaiting human review (S3 Task 3).\n\nAuthentication: enforced by the auth_middleware before this is reached.\nMetadata only \u2014 never the draft body (a deferred Slice 4c surface). The\nqueue is derived from the audit trail (ADR-0011); the handler only wires\nthe store snapshot and the live parked-check into the pure derivation.",
        "operationId": "list_pending_reviews_api_reviews_pending_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingReviewsResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Pending Reviews"
      }
    },
    "/health": {
      "get": {
        "description": "Unauthenticated health check \u2014 used by load balancers and CI smoke tests.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
