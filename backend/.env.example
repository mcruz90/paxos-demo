# Copy this to .env and fill in values. Never commit .env.
# main.py calls load_dotenv() — values here do NOT override real env vars.

# Required: Bearer token for /api/* routes (service / CI identity).
# Browsers instead authenticate with the paxos_session cookie (ADR-0013).
API_SECRET_KEY=change-me-before-running

# Demo browser credentials for POST /api/auth/login (session-cookie auth).
# Pre-DB single-user demo store; real auth replaces this at Phase 3.
DEMO_USER=demo
DEMO_PASSWORD=change-me-before-running

# CORS allowlist for the browser SPA (comma-separated). allow_credentials is on
# (cookies), so "*" is not permitted. Defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Required: LLM backend selection. No default — the provider decision is
# deliberately open (see ml/llm_backend.py). Implemented: "mock", "groq".
LLM_BACKEND=mock

# Groq — only needed when LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# Per-request timeout for remote LLM providers (seconds)
LLM_TIMEOUT_SECONDS=30
