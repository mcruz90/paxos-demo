# Copy this to .env and fill in values. Never commit .env.

# Required: Bearer token for all /api/* routes
API_SECRET_KEY=change-me-before-running

# LLM Backend: "ollama" (local dev) or "groq" (demo/presentation)
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq API — only needed when LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Langfuse observability — optional; tracing degrades gracefully if absent
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
